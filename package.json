{
  "name": "narrator-ide",
  "version": "2.0.0",
  "description": "Browser IDE with AI narration, thinking-mode voice, Monaco editor, terminal, and Clawbot agentic coding",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "ext:build": "cd vscode-extension && npm install && npm run compile",
    "ext:package": "cd vscode-extension && vsce package",
    "setup": "npm install"
  },
  "keywords": [
    "ide",
    "narration",
    "ai",
    "vscode",
    "monaco",
    "terminal",
    "clawbot",
    "thinking",
    "personas"
  ],
  "author": "LÉO",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.16.0",
    "@huggingface/inference": "^4.13.4",
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "elevenlabs": "^1.59.0",
    "express": "^4.18.2",
    "ollama": "^0.6.3",
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
