# Narrator IDE Environment Variables

# Multi-LLM Provider (options: claude, ollama, hf, grok)
LLM_PROVIDER=claude

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HF_TOKEN=hf_your_token_here
XAI_API_KEY=xai_your_key_here

# Ollama Configuration (if using ollama provider)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# Vibe Coder — Dual-Model Config
# Model A: Coding (needs strong code generation)
VIBE_CODER_MODEL=kimi-k2.5:cloud
# Model B: Narration (lightweight, fast — converts thoughts to persona voice)
VIBE_NARRATOR_MODEL=qwen2.5:7b

# ElevenLabs API Key (for text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
